OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DATEGPT_PROVIDER=openai
DATEGPT_MODEL=

# Engine code does not bundle prompts, scenario content, or game Saves.
# Mount these independently in the future launcher/runtime configuration.
DATEGPT_PROMPT_DIR=
DATEGPT_PROMPT_SOURCE=https://github.com/tls8012/chatgpt-animevisualnovel/tree/main/scaffolding
DATEGPT_SOURCE_CACHE_DIR=
DATEGPT_SCENARIO_DIR=
DATEGPT_CARTRIDGE_DIR=
DATEGPT_SAVE_DIR=
DATEGPT_RUNTIME_DIR=

# Personal provider/model/API-key settings written by commands live here.
# Defaults to BACKEND/user_data/config and is excluded from git.
DATEGPT_CONFIG_DIR=

# Development harness default. Local directory or GitHub tree URL.
DATEGPT_TEST_CARTRIDGE_SOURCE=
